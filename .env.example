# Copy to .env.local for local development. On Netlify, set these in Site settings > Environment variables.

# Public site URL (used for emails and SEO). Outside Netlify, SITE_URL sets the blog's canonical origin;
# on Netlify the origin comes from Netlify's own URL variable automatically.
NEXT_PUBLIC_SITE_URL=https://www.falconurgentdelivery.com
SITE_URL=https://www.falconurgentdelivery.com

# Driver page (/driver): PIN chosen by Falcon, and a long random string that signs the login cookie
DRIVER_PIN=
DRIVER_SESSION_SECRET=

# Resend (proof-of-delivery emails to customers). Domain must be verified in Resend (SPF + DKIM).
RESEND_API_KEY=
EMAIL_FROM="Falcon Urgent Delivery <deliveries@falconurgentdelivery.com>"
EMAIL_COPY_TO=wahi.kachichyan@gmail.com
